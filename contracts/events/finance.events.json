{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "erp-finance 事件清单",
  "note": "只增不改：可以加字段、加事件，不删字段、不改类型、不改 subject。消费者宽容反序列化（不认识的字段忽略）。",
  "envelope": {
    "description": "所有事件共用的信封，由 be-sdk 的 Outbox 填写与校验",
    "required": ["subject", "aggregate_id", "version", "trace_id", "causation_id", "hop_count", "occurred_at"],
    "properties": {
      "subject":      { "type": "string", "pattern": "^[a-z]+\\.[a-z-]+\\.[a-z-]+\\.v[0-9]+$" },
      "aggregate_id": { "type": "string" },
      "version":      { "type": "integer", "description": "聚合版本，单调递增；消费者只在严格大于本地当前值时更新，因此不怕乱序与重复投递" },
      "trace_id":     { "type": "string" },
      "causation_id": { "type": "string" },
      "hop_count":    { "type": "integer", "maximum": 5, "description": "事件链跳数；大于 5 直接进死信队列，防止事件互相触发成环" },
      "occurred_at":  { "type": "string", "format": "date-time" }
    }
  },
  "events": [
    {
      "subject": "finance.voucher.posted.v1",
      "grade": "peripheral",
      "note": "旁路分析事件：凭证过账后发，供报表 / 分析类下游订阅，不进核心交易链路。",
      "payload": {
        "type": "object",
        "required": ["entry_id", "entry_no", "post_no", "period", "amount"],
        "properties": {
          "entry_id":  { "type": "string" },
          "entry_no":  { "type": "string" },
          "post_no":   { "type": "string" },
          "period":    { "type": "string" },
          "amount":    { "type": "string", "description": "decimal-as-string" }
        }
      }
    },
    {
      "subject": "finance.credit.rejected.v1",
      "grade": "core",
      "note": "核心交易事件：经 Outbox 持久化，消费者必须幂等，处理失败进死信队列。这是一条事件反向流回上游的边——消费者是 erp-sales，收到后把订单转为挂起；它只在事件图里，不是同步依赖。",
      "payload": {
        "type": "object",
        "required": ["customer_id", "order_id", "exposure", "limit"],
        "properties": {
          "customer_id": { "type": "string" },
          "order_id":    { "type": "string" },
          "exposure":    { "type": "string", "description": "过账后的已用额度，decimal-as-string" },
          "limit":       { "type": "string", "description": "客户的额度值，decimal-as-string" }
        }
      }
    }
  ]
}
